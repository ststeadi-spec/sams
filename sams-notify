"""Send Samuel a text on his phone (iMessage or Telegram) from Sams:  sams-notify "<text>"   (or text on stdin)
Prints OK, or NOT_CONFIGURED (exit 3)."""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from sams_common import send, paired, TelegramError

text = " ".join(sys.argv[1:]) or (sys.stdin.read() if not sys.stdin.isatty() else "")
if not text.strip() or text.strip() in ("-h", "--help"):
    print(__doc__); sys.exit(2)
if not paired():
    print("NOT_CONFIGURED"); sys.exit(3)
try:
    send(text); print("OK")
except TelegramError as e:
    print("NOT_CONFIGURED", e); sys.exit(3)
